#include <iostream>
using namespace std;

int contador = 1;

// Función recursiva 
void imprimirFila(int** matrix, int fila, int col, int size) {
    if (col == size) {
        cout << endl;
        return;
    }
    cout << matrix[fila][col] << " ";
    imprimirFila(matrix, fila, col + 1, size);
}

int main() {
    int size = 10;

    int** matrix = new int* [size];
    for (int i = 0; i < size; i++) {
        matrix[i] = new int[size];
    }

    for (int i = 0; i < size; i++)
        for (int j = 0; j < size; j++)
            matrix[i][j] = 0;

    int maxLen = 6;
    for (int i = 0; i < size; i++) {
        int length;

        if (i < maxLen) {
            length = maxLen - i;
        }
        else if (i == maxLen) {
            length = 1;
        }
        else if (i < 2 * maxLen) {
            length = i - maxLen + 1;
        }
        else {
            length = 0;
        }

        for (int j = 0; j < length; j++) {
            matrix[i][size - length + j] = contador++;
        }
    }

    for (int i = 0; i < size; i++) {
        imprimirFila(matrix, i, 0, size);
    }

    for (int i = 0; i < size; i++)
        delete[] matrix[i];
    delete[] matrix;

    return 0;
}
