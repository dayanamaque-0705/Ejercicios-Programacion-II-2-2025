#include <iostream>
using namespace std;

int main() {
    const int size = 5;
    const int M = size - 2; // 3

    // Crear matriz
    int** matrix = new int* [size];
    for (int i = 0; i < size; i++) {
        matrix[i] = new int[size];
        for (int j = 0; j < size; j++) matrix[i][j] = 0;
    }

    for (int i = 0; i < size; i++) {
        int filled_cols = (i < M) ? size : M; // 5,5,5,3,3
        for (int j = 0; j < filled_cols; j++) {
            matrix[i][j] = (j + 1 < i + 1) ? (j + 1) : (i + 1);
        }
    }

    // Imprimir
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            if (matrix[i][j] == 0) cout << "  ";
            else cout << matrix[i][j] << " ";
        }
        cout << '\n';
    }

    // Liberar memoria
    for (int i = 0; i < size; i++) delete[] matrix[i];
    delete[] matrix;
    return 0;
}
