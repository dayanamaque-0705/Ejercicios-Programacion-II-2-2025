#include <iostream>

using namespace std;



int main()
{
    int size = 10;
    int** matrix = new int* [size];
    for (int i = 0;i < size;i++)
    {
        *(matrix + i) = new int[size];
    }
    //--------------------------------------------
    int fil = size;
    int col = size;

    cout << "La cantidad de filas y columnas ira tanto en creciente y decreciente." << endl;
    cout << "Ingrese la cantidad de filas: ";
    cin >> fil;
    cout << "Ingrese la cantidad de columnas: ";
    cin >> col;

    //-------------------------------------------------

    for (int i=0;i<size;i++)
    {
        *(*(matrix)+i) = i + 1;
    }

    for (int i = fil;i > 0;i--)
    {
        for (int j = 0;j < i;j++)
        {
            cout << *(*(matrix) + j) << " ";
        }
        cout << endl;
    }

    for (int i = 1;i <= fil;i++)
    {
        for (int j = 0;j < i;j++)
        {
            cout << *(*(matrix) + j) << " ";
        }
        cout << endl;
    }

    //-----------------------------------------------------
        for (int i = 0;i < size;i++)
        {
            delete[] * (matrix + i);
        }

        delete[] matrix;
    }
