#include <iostream>
#include <conio.h>
using namespace std;
int main()
{
    int size = 5;
    int** matrix = new int* [size];
    int rows = size; 
    int N = size;    
    int M = size - 2; 

    
    for (int i = 0; i < N; i++) {
        int cols;
        if (i < M) { 
            cols = N;
        } else { 
            cols = M;
        }
        *(matrix + i) = new int[cols];
        for (int j = 0; j < cols; j++) {
            *(*(matrix + i) + j) = j + 1; 
        }
    }

  
    for (int i = 0; i < N; i++) {
        int cols;
        if (i < M) {
            cols = N;
        } else {
            cols = M;
        }
        for (int j = 0; j < cols; j++) {
            cout << *(*(matrix + i) + j) << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < N; i++) {
        delete[] *(matrix + i);
    }
    delete[] matrix;

    return 0;
}
