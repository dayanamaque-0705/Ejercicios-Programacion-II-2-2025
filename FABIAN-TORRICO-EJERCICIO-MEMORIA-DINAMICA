#include <iostream>
#include <conio.h>
using namespace std;
int main()
{
    int size = 5;

    // Creación
    int** matrix = new int* [size];
    // int* array = new int[size];

    int half = size / 2;
    for (int i = 0; i < size; i++)
    {
        int cols;
        if (i <= half) cols = half - i + 1;
        else cols = i - half + 1;

        *(matrix + i) = new int[cols];
    }


    // Asignar valores
    int rows = size; // filas
    int cols = size; // columnas
    int contador = 1;
    for (int i = 0; i < size; i++) {
        int cols;
        if (i <= half) cols = half - i + 1;
        else cols = i - half + 1;

        for (int j = 0; j < cols; j++) {
            *(*(matrix + i) + j) = contador; 
            contador++;
        }
    }



    // Printear valores
    int N=5;
    for (int i = 0; i < N; i++) {
        int cols = (i <= half) ? (half - i + 1) : (i - half + 1);

        int espacios = (i <= half) ? i : (N - 1 - i);

        // imprimir espacios
        for (int s = 0; s < espacios; s++) {
            cout << "  ";  // dos espacios para que se note
        }

        // imprimir números
        for (int j = 0; j < cols; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }



    // Liberar memoria
    for (int i = 0; i < size; i++) {
        delete[] * (matrix + i);
    }
    delete[] matrix;


    return 0;
}
