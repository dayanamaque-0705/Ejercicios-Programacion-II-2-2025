#include <iostream>

using namespace std;



void asignacionRecursiva(int size,int** matrix,int c)
{
    if (c < size)
    {
        *(*(matrix)+c) = c + 1;
        c++;
        asignacionRecursiva(size,matrix,c);
    }
}


int main()
{
    int size = 20;
    int c = 0;
    int** matrix = new int* [size];
    for (int i = 0;i < size;i++)
    {
        *(matrix + i) = new int[size];
    }
    //--------------------------------------------
    int fil = size;

    cout << "La cantidad de filas y columnas ira tanto en creciente y decreciente." << endl;
    cout << "Ingrese un numero: ";
    cin >> fil;

    //-------------------------------------------------

    asignacionRecursiva(size,matrix,c);

    for (int i=0;i<size;i++)
    {
        *(*(matrix)+i) = i + 1;
    }

    for (int i = fil;i > 0;i--)
    {
        for (int j = 0;j < i;j++)
        {
            cout << *(*(matrix) + j) << " ";
        }
        cout << endl;
    }

    for (int i = 1;i <= fil;i++)
    {
        for (int j = 0;j < i;j++)
        {
            cout << *(*(matrix) + j) << " ";
        }
        cout << endl;
    }

    //-----------------------------------------------------
        for (int i = 0;i < size;i++)
        {
            delete[] * (matrix + i);
        }

        delete[] matrix;
    }
