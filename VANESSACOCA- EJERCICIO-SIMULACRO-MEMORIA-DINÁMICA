#include <iostream>
#include <conio.h>
using namespace std;
int main()
{
    int size = 5;
    int contador = 5;
    // Creación
    int** matrix = new int* [size];


    for (int i = 0; i < size; i++) {
        *(matrix + i) = new int[size];
    }

    // Asignar valores
    int rows = size; // filas
    int cols = size; // columnas
    for (int i = 0; i < rows  ; i++) {
        contador = 5;
        for (int j = 0; j < cols ; j++) {
            // matrix[i][j] = 0;
            if (j <= i) {
                *(*(matrix + i) + j) = contador--;

            }
            

        }
    }

    // Printear valores
    for (int i = 0; i < rows ; i++) {
        for (int j = 0; j < cols ; j++) {
            // cout << matrix[i][j] << " ";
            if (j <= i) {
                cout << *(*(matrix + i) + j) << "\t ";
            }
            
        }
        cout << endl;
    }

    // Liberar memoria
    for (int i = 0; i < size; i++) {
        //delete[] matrix[i];
        delete[] * (matrix + i);
    }
    delete[] matrix;

    return 0;
}
