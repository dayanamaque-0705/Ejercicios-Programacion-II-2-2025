#include <iostream>
using namespace std;

int main()
{
    int size = 5;

    // Creación de la matriz
    int** matrix = new int* [size];

    int N = size;      // 5
    int M = size - 2;  // 3
    int rows = size;
    int cols = size;

    // Asignar valores
    for (int i = 0; i < rows; i++) {
        if (i < N) {
            matrix[i] = new int[N];
        } else {
            matrix[i] = new int[M];
        }

        for (int j = 0; j < cols; j++) {
            if (i < M) {
                if (j < i) {
                    matrix[i][j] = j + 1;
                } else {
                    matrix[i][j] = i + 1;
                }
            } else {
                if (j < cols) {
                    matrix[i][j] = j + 1;
                }
            }
        }
    }

    // Imprimir valores
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << "\n";
    }

    // Liberar memoria
    for (int i = 0; i < size; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;

    return 0;
}
