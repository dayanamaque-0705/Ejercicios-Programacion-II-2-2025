    cout << "Ingrese arreglo B:\n";
    for (int i = 0; i < n; i++) cin >> B[i];

    sumarArreglos(A, B, C, n);

    cout << "Suma: ";
    for (int i = 0; i < n; i++) cout << C[i] << " ";

    delete[] A;
    delete[] B;
    delete[] C;
