///Ejercicio 8
#include <iostream>
using namespace std;

void invertir(int* arr, int n) {
    for (int i = 0; i < n / 2; i++) {
        int tmp = arr[i];
        arr[i] = arr[n - i - 1];
        arr[n - i - 1] = tmp;
    }
}

int main() {
    int n;
    cout << "Ingrese n: ";
    cin >> n;

    int* arr = new int[n];
    cout << "Ingrese " << n << " numeros:\n";
    for (int i = 0; i < n; i++) cin >> arr[i];

    invertir(arr, n);

    cout << "Arreglo invertido: ";
    for (int i = 0; i < n; i++) cout << arr[i] << " ";

    delete[] arr;
    return 0;
}
