#include <iostream>
using namespace std;

int main() {
    int N;
    cout << "Ingrese un numero impar N: ";
    cin >> N;

    int** M = new int*[N];
    for (int i = 0; i < N; i++) M[i] = new int[N];

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N - i; j++) {
            M[i][j] = j + 1;
            cout << M[i][j] << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < N; i++) delete[] M[i];
    delete[] M;
    return 0;
}
////Segunda figura
#include <iostream>
using namespace std;

int main() {
    int N, M;
    cout << "Ingrese N y M (N > M): ";
    cin >> N >> M;

    int** mat = new int*[N];
    for (int i = 0; i < N; i++) mat[i] = new int[N];

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            if (i < M && j < M)
                mat[i][j] = min(i, j) + 1;
            else if (i < M || j < M)
                mat[i][j] = min(i, j) + 1;
            else
                mat[i][j] = 0;
            cout << mat[i][j] << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < N; i++) delete[] mat[i];
    delete[] mat;
    return 0;
}
