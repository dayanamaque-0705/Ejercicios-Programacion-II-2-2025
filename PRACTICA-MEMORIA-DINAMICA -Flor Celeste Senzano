int buscar(int* arr, int n, int x) {
    for (int i = 0; i < n; i++)
        if (arr[i] == x) return i;
    return -1;
}

int main() {
    int n, x;
    cout << "Ingrese n: ";
    cin >> n;

    int* arr = new int[n];
    cout << "Ingrese " << n << " numeros:\n";
    for (int i = 0; i < n; i++) cin >> arr[i];

    cout << "Ingrese valor a buscar: ";
    cin >> x;

