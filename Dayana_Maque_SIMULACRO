#include <iostream>
using namespace std;

void asignarValores(int** matrix, int fila, int col, int N, int mid) {
    if (col >= N) return;

    if (fila <= mid) {
        if (col <= mid - fila) {
            *(*(matrix + fila) + col) = col + 1;
        }
        else {
            *(*(matrix + fila) + col) = 0;
        }
    }
    else {
        if (col <= fila - mid) {
            *(*(matrix + fila) + col) = col + 1;
        }
        else {
            *(*(matrix + fila) + col) = 0;
        }
    }

    asignarValores(matrix, fila, col + 1, N, mid);
}

void voltearHorizontal(int** matrix, int N) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N / 2; j++) {
            int temp = *(*(matrix + i) + j);
            *(*(matrix + i) + j) = *(*(matrix + i) + (N - j - 1));
            *(*(matrix + i) + (N - j - 1)) = temp;
        }
    }
}

int main() {
    int N;
    cin >> N;
    int** matrix = new int* [N];
    for (int i = 0; i < N; i++) {
        *(matrix + i) = new int[N];
    }

    int mid = N / 2;

    for (int i = 0; i < N; i++) {
        asignarValores(matrix, i, 0, N, mid);
    }

    voltearHorizontal(matrix, N);

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            if (*(*(matrix + i) + j) != 0) {
                cout << *(*(matrix + i) + j) << " ";
            }
        }
        cout << endl;
    }

    for (int i = 0; i < N; i++) {
        delete[] * (matrix + i);
    }
    delete[] matrix;
    return 0;
}


