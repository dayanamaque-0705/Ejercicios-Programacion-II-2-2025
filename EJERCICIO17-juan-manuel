#include <iostream>
using namespace std;


void llenarMatriz(int** matriz, int fila, int inicio, int fin, int direccion) {
    if (inicio > fin) return;
    matriz[fila][inicio] = inicio + 1;
    llenarMatriz(matriz, fila, inicio + 1, fin, direccion);
}

void ejercicio17() {
    int n;
    cout << "coloca n"<<endl;
    cin >> n;

    int** matriz = new int* [n];
    for (int i = 0; i < n; i++) {
        matriz[i] = new int[n];
        for (int j = 0; j < n; j++) {
            matriz[i][j] = 0;
        }
    }

    int mitad = n / 2;
    for (int i = 0; i < n; i++) {
        int limite;
        if (i <= mitad) {
            limite = i;
        }
        else {
            limite = n - i - 1;
        }
        llenarMatriz(matriz, i, 0, limite, 1);
    }

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (matriz[i][j] != 0) {
                cout << matriz[i][j] << " ";
            }
            else {
                cout << "  ";
            }
        }
        cout << endl;
    }

    for (int i = 0; i < n; i++) {
        delete[] matriz[i];
    }
    delete[] matriz;
}
int main() 
{
    ejercicio17();
    return 0;
}

