#include <iostream>
using namespace std;



void ejercicio17() {
    int N;
    cout << "Ingrese numero impar: ";
    cin >> N;

    // Crear matriz 
    int** matrix = new int* [N];

    // asignar memoria dinámica para cada fila
    for (int i = 0; i < N; i++) 
    {
        int cols;
        if (i <= N / 2) {
            cols = N / 2 - i + 1;   // parte arriba
        }
        else {
            cols = i - N / 2 + 1;   // parte abajo
        }
        matrix[i] = new int[cols];

        // llenar con valores 1 cols
        for (int j = 0; j < cols; j++) {
            matrix[i][j] = j + 1;
        }
    }

    // Imprimir matriz cm la figura
    for (int i = 0; i < N; i++) {
        int cols;
        if (i <= N / 2) {
            cols = N / 2 - i + 1;
        }
        else {
            cols = i - N / 2 + 1;
        }

        // Espacios para dar forma 
        int spaces = (N / 2 - cols + 1);
        for (int s = 0; s < spaces; s++) {
            cout << "  ";
        }

        for (int j = 0; j < cols; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    // Liberar memoria
    for (int i = 0; i < N; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;
}





int main()
{
    ejercicio17();
}
