#include <iostream>
using namespace std;

int main()
{
    int size = 5;

    int** matrix = new int* [size];
    for (int i = 0; i < size; i++) {
        matrix[i] = new int[size];
    }

    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            matrix[i][j] = 0; 

            if (j == size - 1) {
                matrix[i][j] = 1;
            }

            if (j == size - 2 && i != size / 2) {
                matrix[i][j] = 2;
            }

            if (j == size - 3 && (i == 0 || i == size - 1)) {
                matrix[i][j] = 3;
            }
        }
    }

    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            cout << matrix[i][j];
        }
        cout << endl;
    }

    for (int i = 0; i < size; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;

    return 0;
}
