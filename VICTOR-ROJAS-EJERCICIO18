#include <iostream>
#include <conio.h>
using namespace std;

int main()
{
    int size = 5;
    // Creación de la matriz
    int** matrix = new int* [size];

    int rows = size; // filas
    int N = size;    // 5
    int M = size - 2; // 3

    // Asignar memoria y valores
    for (int i = 0; +:+i < rows; i++) {
        if (i < N) {
            *(matrix + i) = new int[N];
        } else {
            *(matrix + i) = new int[M];
        }

        for (int j = 0; j < (i < N ? N : M); j++) {
            if (j < N) {
                if (i <= j) {
                    *(*(matrix + i) + j) = 1 + (j - i);
                } else {
                    *(*(matrix + i) + j) = 1 + (i - j);
                }
            }
        }
    }

    // Imprimir valores
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < (i < N ? N : M); j++) {
            cout << *(*(matrix + i) + j) << " ";
        }
        cout << endl;
    }

    // Liberar memoria
    for (int i = 0; i < size; i++) {
        delete[] *(matrix + i);
    }
    delete[] matrix;

    _getch(); // Para pausar la ejecución y ver el resultado
    return 0;
}
