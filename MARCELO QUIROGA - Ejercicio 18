#include <iostream>

using namespace std;




void Tarea()
{
    int size = 50;
    int** matriz = new int* [size];

    for (int i = 0;i < size;i++)
    {
        *(matriz + i) = new int[size];
    }
    //-----------------------------------------
    int fil, col;
    cout << "Ingrese la cantidad de filas: ";
    cin >> fil;
    cout << "Ingrese a cantidad de columnas: ";
    cin >> col;

    for (int i=0;i<fil;i++)
    {
        *(*(matriz) + i) = 1;
    }

    for (int i = 0;i < fil;i++)
    {
        for (int j = 1;j <= col;j++)
        {
            if (i < fil)
            {
                cout << *(*(matriz)+i) << " ";
            }
            else
            {
                cout << *(*(matriz)+j) << " ";
            }
            
        }
        cout << endl;
    }
    //------------------------------------
    for (int i=0;i<fil;i++)
    {
        delete* (matriz + i);
    }

    delete[] matriz;

}

int main()
{
    Tarea();
}

