#include <iostream>
#include <iomanip> // Para setw
using namespace std;

void llenarcasillas(int** matriz, int fila, int N);
void imprimircasillas(int** matriz, int fila, int N);

int main() {
    int N;
    cout << "Ingrese un numero impar N ";
    cin >> N;

    if (N % 2 == 0) {
        cout << "N debe ser impar" << endl;
        return 1;
    }

    int** mat = new int*[N];
    for (int i = 0; i < N; i++)
        mat[i] = new int[N];

    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            mat[i][j] = 0;

    llenarcasillas(mat, 0, N);

    imprimircasillas(mat, 0, N);

    for (int i = 0; i < N; i++)
        delete[] mat[i];
    delete[] mat;

    return 0;
}

void llenarcasillas(int** matriz, int fila, int N) {
    if (fila == N)
        return;

    int m = N / 2;

    if (fila < m) {
        int espace = fila;
        int valor = fila + 1;
        for (int j = 0; j < N - espace; j++)
            matriz[fila][j + espace] = j + 1;
    } else if (fila == m) {
        matriz[fila][m] = 1;
    } else 
    {
        int sim = N - fila - 1;
        int espace = sim;
        for (int j = 0; j < N - espace; j++)
            matriz[fila][j + espace] = j + 1;
    }

    llenarcasillas(matriz, fila + 1, N);
}
void imprimircasillas(int** matriz, int fila, int N) {
    if (fila == N)
        return;

    for (int j = 0; j < N; j++) {
        if (matriz[fila][j] == 0)
            cout << "  ";
        else
            cout << matriz[fila][j];
    }
    cout << endl;

    imprimircasillas(matriz, fila + 1, N);
}
