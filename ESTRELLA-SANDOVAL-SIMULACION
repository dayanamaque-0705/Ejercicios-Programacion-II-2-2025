#include <iostream>
using namespace std;

void crearMatrizRecursiva(int** matrix, int i, int size) {
    if (i < size) {
        *(matrix + i) = new int[size]();
        crearMatrizRecursiva(matrix, i + 1, size);
    }
}

int main()
{
    int size = 5;
    int** matrix = new int* [size];

    crearMatrizRecursiva(matrix, 0, size);

    //--------------- EJERCICIO 1 ---------------
    int mitad = (size + 1) / 2;
    int contador = 1; 

    for (int i = 0; i < size; i++)
    {
        for (int j = 0; j < size; j++)
        {
            if (i < mitad) {
                if (j < mitad - i) {
                    *(*(matrix + i) + j) = 1;
                }
            }
            else {
                if (j < i - mitad + 2) {
                    *(*(matrix + i) + j) = 1;
                }
            }
        }
        contador++;
    }

    // VOLTEAR EN SENTIDO HORIZONTAL
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size / 2; j++) {
            int temp = *(*(matrix + i) + j);
            *(*(matrix + i) + j) = *(*(matrix + i) + size - 1 - j);
            *(*(matrix + i) + size - 1 - j) = temp;
        }
    }

    // IMPRIMIR VALORES
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            if (*(*(matrix + i) + j) == 1) {
                cout << "1 ";
            }
            else {
                cout << "  ";
            }
        }
        cout << endl;
    }

    // LIBERAR MEMORIA
    for (int i = 0; i < size; i++) {
        delete[] * (matrix + i);
    }
    delete[] matrix;
}
