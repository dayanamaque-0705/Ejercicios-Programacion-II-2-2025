void ejercicio16() {
    int n, m;
    cout << "Ingrese n y m: ";
    cin >> n >> m;
    int** a = new int* [n];
    int** b = new int* [n];
    int** c = new int* [n];

    for (int i = 0; i < n; i++) {
        a[i] = new int[m];
        b[i] = new int[m];
        c[i] = new int[m];
    }

    cout << "Matriz A:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> a[i][j];
        }
    }

    cout << "Matriz B:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> b[i][j];
        }
    }

    cout << "Resultado:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            c[i][j] = a[i][j] + b[i][j];
            cout << c[i][j] << " ";
        }
        cout << "\n";
    }

    for (int i = 0; i < n; i++) {
        delete[] a[i];
        delete[] b[i];
        delete[] c[i];
    }
    delete[] a;
    delete[] b;
    delete[] c;
}

void ejercicio17() {
    int N;
    cout << "Ingrese un numero impar N: ";
    cin >> N;
    int** arr = new int* [N];
    int mitad = N / 2;

    for (int i = 0; i < N; i++) {
        int tam;
        if (i <= mitad) {
            tam = mitad - i + 1;
        }
        else {
            tam = i - mitad + 1;
        }
        arr[i] = new int[tam];
        for (int j = 0; j < tam; j++) {
            arr[i][j] = j + 1;
            cout << arr[i][j] << " ";
        }
        cout << "\n";
    }

    for (int i = 0; i < N; i++) {
        delete[] arr[i];
    }
    delete[] arr;
}

void ejercicio18() {
    int N, M;
    cout << "Ingrese N y M (N>M): ";
    cin >> N >> M;
    int** arr = new int* [N];
    int* cols = new int[N];

    for (int i = 0; i < N; i++) {
        if (i < M) {
            cols[i] = N;
        }
        else {
            cols[i] = M;
        }
        arr[i] = new int[cols[i]];
        for (int j = 0; j < cols[i]; j++) {
            if (i < M) {
                if (j < i) {
                    arr[i][j] = j + 1;
                }
                else {
                    arr[i][j] = i + 1;
                }
            }
            else {
                arr[i][j] = j + 1;
            }
            cout << arr[i][j] << " ";
        }
        cout << "\n";
    }

    for (int i = 0; i < N; i++) {
        delete[] arr[i];
    }
    delete[] arr;
    delete[] cols;
}


